DATABASE_URL=postgres://verso:verso@localhost:55432/verso

# AI label reading (POST /v1/ocr). Pick ONE route. Keys go in .env, never in git.
#
# Gemini free tier — free key at aistudio.google.com/apikey. Free-tier content is
# used by Google to improve its products.
# VERSO_OCR_PROVIDER=gemini
# GEMINI_API_KEY=
# VERSO_OCR_MODEL=gemini-3.8-flash       # default; falls back to gemini-3.5-flash-lite when busy
#
# OpenCode Zen (paid). Its free models answer 403 to any client but OpenCode itself. — uses the key the OpenCode app already stores
# (~/.local/share/opencode/auth.json), or set OPENCODE_API_KEY here.
# VERSO_OCR_PROVIDER=opencode
# VERSO_OCR_MODEL=claude-sonnet-5        # or claude-opus-5 (more accurate), claude-haiku-4-5 (cheaper)
#
# Anthropic directly
# ANTHROPIC_API_KEY=

# Re-download the official lists (EU, FDA, IARC, Prop 65, FSSAI, Codex) once a day from the
# API process; `pnpm sources:sync` does the same by hand.
VERSO_SOURCE_SYNC=daily
